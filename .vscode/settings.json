{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.fixAll.eslint": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
    "editor.indentSize": 4,
    "editor.tabSize": 4
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.indentSize": 2,
    "editor.tabSize": 2
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.indentSize": 2,
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.indentSize": 2
  },
  "files.associations": {
    "*.sql": "sql"
  },
  "files.nesting.enabled": true,
  "files.nesting.patterns": {
    "package.json": "package-lock.json, tsconfig.json, vite.config.ts, tailwind.config.js, postcss.config.js",
    ".env": ".env.*",
    "composer.json": "composer.lock, phpunit.xml"
  }
}
