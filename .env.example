# PCBuilder Global Environment Variables Example
# Copy this file to '.env' and fill in the secrets for local development.

# Application Settings
APP_ENV=local
APP_DEBUG=true

# Database Settings (MySQL)
DB_HOST=db
DB_PORT=3306
DB_NAME=pcbuilder
DB_USER=root
DB_PASSWORD=YourStrongPasswordHere123

# Cache Settings
REDIS_CONNECTION=redis:6379

# JWT Authentication Settings
JWT_SECRET=YourSuperLongAndSecureSecretKeyHereMustBeAtLeast32Chars!
JWT_ISSUER=PCBuilderIssuer
JWT_AUDIENCE=PCBuilderAudience

# AI Module API Keys
OPENAI_API_KEY=your_openai_api_key_placeholder
GROQ_API_KEYS="gsk_key1,gsk_key2,gsk_key3"
GEMINI_API_KEY=your_gemini_api_key_placeholder

# ImageKit Configuration (Cloud Photo Storage)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_placeholder
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_placeholder
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/
VITE_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_placeholder
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/

# ==============================================================================
# Email & Alerts Configuration (Brevo SMTP & Notifications)
# ==============================================================================
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_user
BREVO_SMTP_PASS=your_brevo_smtp_password
EMAIL_FROM="PC Kinba Notifications <notifications@pckinba.com>"
PUBLIC_APP_URL=http://localhost:5173

