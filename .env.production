# PCBuilder Production Environment Variables Template
# DO NOT COMMIT SECRETS TO GIT

APP_ENV=production
APP_DEBUG=false

# Database Settings (MySQL)
DB_HOST=prod-db-server-url
DB_PORT=3306
DB_NAME=pcbuilder
DB_USER=root
DB_PASSWORD=

# Cache Settings
REDIS_CONNECTION=prod-redis-server-url:6379

# Security Settings
JWT_SECRET=
JWT_ISSUER=PCBuilderIssuerProd
JWT_AUDIENCE=PCBuilderAudienceProd

# AI Integrations
GEMINI_API_KEY=
